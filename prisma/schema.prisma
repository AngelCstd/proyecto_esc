generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "noktos_auth"]
}

model UserInfo {
  id         String   @id @db.Uuid
  created_at DateTime @db.Timestamptz(6)
  id_user    String?  @unique @db.Uuid
  id_viajero String?  @db.VarChar
  id_agente  String?  @db.VarChar
  rol        String?  @db.VarChar

  @@map("user_info")
  @@schema("public")
}
